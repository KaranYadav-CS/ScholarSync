# Environment Configuration for ScholarSync
# Copy this file to .env for local development

NODE_ENV=development
PORT=5000

# Authentication & Session Security
JWT_SECRET=scholarsync_development_secret_key_change_in_production_32chars!
COOKIE_SECRET=scholarsync_cookie_secret_key_change_in_prod!
TOKEN_EXPIRATION=7d

# Local Demo Mode (Set to true to run locally with sample data without Azure credentials)
DEMO_MODE=true

# Azure SQL Database Configuration (Required when DEMO_MODE=false)
AZURE_SQL_SERVER=your-sql-server.database.windows.net
AZURE_SQL_DATABASE=scholarsync-db
AZURE_SQL_USER=scholarsyncadmin
AZURE_SQL_PASSWORD=YourStrongPasswordHere!
AZURE_SQL_PORT=1433
AZURE_SQL_ENCRYPT=true

# Azure Blob Storage Configuration (Required when DEMO_MODE=false)
AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount
AZURE_STORAGE_CONTAINER_NAME=scholarship-documents
AZURE_STORAGE_ACCESS_KEY=YourAzureStorageAccessKeyHere==
AZURE_STORAGE_CONNECTION_STRING=
